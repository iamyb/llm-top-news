# 复制为 .env 并填写; 脚本启动时自动加载（不覆盖已存在的 shell 变量）

# 可选: GitHub Search API 无 token 10 req/min, 本工具每次仅 1 个查询, 一般够用
GITHUB_TOKEN=

# 可选: Reddit 源（公开端点在本机 IP 被 403, 需 OAuth 脚本凭据）
# 在 https://www.reddit.com/prefs/apps 创建 script 类型 app 获取
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# 可选: LLM 摘要（任意 OpenAI 兼容端点）; 不配则摘要退化为截断原文
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=
